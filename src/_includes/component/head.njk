<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <!-- Primary SEO Tags -->
  <title>{{ site.name }} | Commercial Janitorial & Emergency Restoration Services in Belleville & Quinte Region</title>
  <meta name="description" content="MOPS Group Inc. provides expert Commercial Janitorial & Cleaning Services alongside 24/7 Emergency Disaster Restoration (Water Damage, Fire & Smoke, Mold Remediation, and Full Property Rebuilds) across Belleville, Quinte West, and Prince Edward County." />
  <meta name="keywords" content="Janitorial Services, Commercial Cleaning, Office Cleaning, Post-Construction Cleanup, Disaster Restoration, Water Damage Restoration, Fire Damage Repair, Mold Remediation, Structural Drying, Emergency Restoration, Belleville, Quinte West, Prince Edward County, MOPS Group Inc" />
  <meta name="author" content="{{ site.name }}" />
  <meta name="robots" content="index, follow" />

  <!-- Canonical URL -->
  <link rel="canonical" href="{{ site.url }}" />

  <!-- Preload Hero Images for LCP Optimization -->
  <link rel="preload" as="image" href="/assets/commercial-spaces.png" media="(min-width: 769px)" fetchpriority="high" />
  <link rel="preload" as="image" href="/assets/water_damage_panorama.png" media="(min-width: 769px)" fetchpriority="high" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="{{ site.url }}" />
  <meta property="og:title" content="{{ site.name }} | Commercial Janitorial & Emergency Restoration Services" />
  <meta property="og:description" content="Professional commercial janitorial cleaning and 24/7 emergency disaster restoration (water, fire, mold, full rebuilds) serving Belleville and the Quinte region." />
  <meta property="og:image" content="{{ site.url }}assets/mops-group-logo-link.jpg" />

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content="{{ site.url }}" />
  <meta property="twitter:title" content="{{ site.name }} | Janitorial and Restoration Services" />
  <meta property="twitter:description" content="Vibrant cleanliness and 24/7 disaster recovery. Trusted commercial janitorial and emergency restoration in Belleville & Quinte." />
  <meta property="twitter:image" content="{{ site.url }}assets/mops-group-logo-link.jpg" />

  <!-- Google Fonts & Fontshare — matching WEB-MOPS-GROUP source -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <!-- Fontshare: Switzer -->
  <link href="https://api.fontshare.com/v2/css?f[]=switzer@400,500,700&display=swap" rel="stylesheet">

  <!-- Core Stylesheet -->
  <link rel="stylesheet" href="/style.css" />

  <!-- Favicons and Manifest -->
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <!-- Structured Data: Local Business (Janitorial & Restoration Services) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": ["LocalBusiness", "CleaningService"],
    "name": "{{ site.name }}",
    "description": "MOPS Group Inc. provides expert Commercial Janitorial & Cleaning Services alongside 24/7 Emergency Disaster Restoration Services (Water Damage, Fire & Smoke, Mold Remediation, and Full Property Rebuilds) across Belleville and the Quinte region.",
    "url": "{{ site.url }}",
    "telephone": "{{ site.phone }}",
    "email": "{{ site.email }}",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "41 Dussek St",
      "addressLocality": "Belleville",
      "addressRegion": "ON",
      "postalCode": "K8N 5R9",
      "addressCountry": "CA"
    },
    "image": "{{ site.url }}assets/mops-group-logo-link.jpg",
    "priceRange": "$$",
    "areaServed": [
      {
        "@type": "AdministrativeArea",
        "name": "Belleville, ON"
      },
      {
        "@type": "AdministrativeArea",
        "name": "Quinte West, ON"
      },
      {
        "@type": "AdministrativeArea",
        "name": "Prince Edward County, ON"
      }
    ],
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "MOPS Group Inc Services",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Commercial Janitorial & Cleaning Services",
            "description": "Comprehensive commercial office cleaning, post-construction cleanup, industrial sanitizing, and municipal facility maintenance."
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Disaster Restoration & Recovery Services",
            "description": "24/7 emergency response for water damage extraction, fire and smoke deodorization, HEPA mold remediation, hazmat abatement, and full property rebuilds."
          }
        }
      ]
    }
  }
  </script>

  <!-- Structured Data: FAQ Page Schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What cleaning services does Mops Group Inc. offer?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Mops Group Inc. provides specialized commercial janitorial services tailored to different properties: office spaces, post-construction cleanup, industrial facilities, government properties, car dealerships, and vacation rentals."
        }
      },
      {
        "@type": "Question",
        "name": "What types of restoration do you offer?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We offer 24/7 emergency water damage restoration, fire and smoke recovery, HEPA mold remediation, hazmat abatement, trauma cleanup, and full property rebuilds for residential and commercial properties throughout the Quinte region."
        }
      },
      {
        "@type": "Question",
        "name": "How quickly can you respond to an emergency?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Our emergency line is staffed 24 hours a day, 7 days a week. In most cases we can have a restoration crew on-site within 1–2 hours of your call to prevent secondary damage."
        }
      },
      {
        "@type": "Question",
        "name": "Do you work directly with insurance companies?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. We provide direct insurance billing and coordinate with your adjuster from initial assessment through final sign-off with detailed documentation."
        }
      },
      {
        "@type": "Question",
        "name": "What geographic areas do you serve?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We are based in Belleville, Ontario, and proudly serve the entire Quinte region, including Belleville, Quinte West, and Prince Edward County."
        }
      },
      {
        "@type": "Question",
        "name": "How much do your janitorial and restoration services cost?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Because every property is unique, we provide personalized quotes based on square footage, condition, frequency, and required restoration scope. Contact us at (613) 329-8439 or hello@mopsinc.com for a free quote."
        }
      },
      {
        "@type": "Question",
        "name": "Are your technicians certified and vetted?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. All MOPS Group Inc. technicians hold IICRC (Institute of Inspection Cleaning and Restoration Certification) credentials, and all staff are fully vetted, bonded, and insured."
        }
      },
      {
        "@type": "Question",
        "name": "Is MOPS Group Inc. a certified living wage employer?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, MOPS Group Inc. is a certified Ontario Living Wage Employer. We are committed to paying fair wages, reducing employment barriers, and offering flexible hours across all operations."
        }
      }
    ]
  }
  </script>

  <!-- Cloudflare Turnstile API Script -->
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" defer></script>
</head>