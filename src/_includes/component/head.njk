<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  {%- set seoTitle = title or (site.name + " | Commercial Janitorial & Restoration in Belleville") %}
  {%- set seoDescription = description or "Commercial janitorial cleaning and 24/7 emergency disaster restoration for water, fire and mold damage across Belleville, Quinte West and Prince Edward County." %}
  {%- set canonicalUrl = page.url | htmlBaseUrl(site.url) %}

  <!-- Primary SEO Tags -->
  <title>{{ seoTitle }}</title>
  <meta name="description" content="{{ seoDescription }}" />
  <meta name="author" content="{{ site.name }}" />
  <meta name="robots" content="{% if noindex %}noindex, follow{% else %}index, follow{% endif %}" />
  {%- if not noindex %}

  <!-- Canonical URL -->
  <link rel="canonical" href="{{ canonicalUrl }}" />
  {%- endif %}
  {%- if preloadImage %}

  <!-- Preload Hero Image for LCP Optimization -->
  <link rel="preload" as="image" href="{{ preloadImage }}" media="(min-width: 769px)" fetchpriority="high" />
  {%- endif %}

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="{{ canonicalUrl }}" />
  <meta property="og:title" content="{{ seoTitle }}" />
  <meta property="og:description" content="{{ seoDescription }}" />
  <meta property="og:image" content="{{ site.url }}assets/mops-group-og.jpg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content="{{ canonicalUrl }}" />
  <meta property="twitter:title" content="{{ seoTitle }}" />
  <meta property="twitter:description" content="{{ seoDescription }}" />
  <meta property="twitter:image" content="{{ site.url }}assets/mops-group-og.jpg" />

  <!-- Google Fonts & Fontshare — matching WEB-MOPS-GROUP source -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <!-- Fontshare: Switzer -->
  <link href="https://api.fontshare.com/v2/css?f[]=switzer@400,500,700&display=swap" rel="stylesheet">

  <!-- Core Stylesheet -->
  <link rel="stylesheet" href="/style.css" />

  <!-- Favicons and Manifest -->
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <!-- Structured Data: Local Business (Janitorial & Restoration Services) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": ["LocalBusiness", "CleaningService"],
    "@id": "{{ site.url }}#business",
    "name": "{{ site.name }}",
    "description": "MOPS Group Inc. provides expert Commercial Janitorial & Cleaning Services alongside 24/7 Emergency Disaster Restoration Services (Water Damage, Fire & Smoke, Mold Remediation, and Full Property Rebuilds) across Belleville and the Quinte region.",
    "url": "{{ site.url }}",
    "telephone": "{{ site.phone }}",
    "email": "{{ site.email }}",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "41 Dussek St",
      "addressLocality": "Belleville",
      "addressRegion": "ON",
      "postalCode": "K8N 5R9",
      "addressCountry": "CA"
    },
    "image": "{{ site.url }}assets/mops-group-og.jpg",
    "logo": "{{ site.url }}assets/mops-group-logo-link.jpg",
    "priceRange": "$$",
    "areaServed": [
      {
        "@type": "AdministrativeArea",
        "name": "Belleville, ON"
      },
      {
        "@type": "AdministrativeArea",
        "name": "Quinte West, ON"
      },
      {
        "@type": "AdministrativeArea",
        "name": "Prince Edward County, ON"
      }
    ],
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "MOPS Group Inc Services",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Commercial Janitorial & Cleaning Services",
            "description": "Comprehensive commercial office cleaning, post-construction cleanup, industrial sanitizing, and municipal facility maintenance."
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Disaster Restoration & Recovery Services",
            "description": "24/7 emergency response for water damage extraction, fire and smoke deodorization, HEPA mold remediation, hazmat abatement, and full property rebuilds."
          }
        }
      ]
    }
  }
  </script>
  {%- if page.url == "/janitorial/" %}

  <!-- Structured Data: FAQ Page Schema (mirrors the FAQ shown on this page) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What cleaning services does Mops Group Inc. offer?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Mops Group Inc. provides specialized commercial cleaning services tailored to different properties and needs: comprehensive Commercial office and janitorial services; secure sanitization for Municipal and Gov facilities; and fast, high-standard turnovers for Hotel Takeovers and Vacation Rentals."
        }
      },
      {
        "@type": "Question",
        "name": "What geographic areas do you serve?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We are based in Belleville, Ontario, and proudly serve the entire Quinte region, including Belleville, Quinte West, and Prince Edward County."
        }
      },
      {
        "@type": "Question",
        "name": "How much do your cleaning services cost?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Because every space is unique, we do not have a standard flat-rate price list. We provide personalized quotes based on factors like square footage, the current condition of the space, cleaning frequency, and specific tasks required. Contact us today for a free walkthrough and customized quote!"
        }
      },
      {
        "@type": "Question",
        "name": "What are your safety and sanitization standards?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Safety and hygiene are our top priorities. We follow strict disinfection protocols and use professional-grade, eco-friendly sanitizers. Additionally, all Mops Group Inc. staff members are fully vetted, bonded, insured, and trained to meet strict standards."
        }
      },
      {
        "@type": "Question",
        "name": "Why is being a Living Wage Employer important?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "By paying certified living wages, we invest in our employees' health and financial well-being. This ensures lower staff turnover, higher job satisfaction, and a dedicated, motivated team that takes pride in delivering exceptional service to our clients."
        }
      }
    ]
  }
  </script>
  {%- endif %}

  <!-- Cloudflare Turnstile API Script -->
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" defer></script>
</head>
