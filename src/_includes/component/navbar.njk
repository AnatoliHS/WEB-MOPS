<!-- MOBILE CLEAN WHITE OVERLAY -->
<div class="nav-mobile-overlay" id="nav-overlay"></div>

<!-- FLOATING HEADER NAVBAR -->
<header class="floating-navbar" id="navbar">
  <div class="floating-nav-container">
    <!-- Left Logo -->
    <a href="/" class="floating-nav-logo" aria-label="MOPS Group Inc. Home">
      <img
        src="{% if page.url == '/restoration/' %}/assets/mops-group-resoration.png{% elif page.url == '/janitorial/' %}/assets/mops-group-janitorial.png{% else %}/assets/mops-group-general.png{% endif %}"
        alt="MOPS Group Inc. Logo">
    </a>

    <!-- Center Contact Info (Desktop Only on Janitorial & Restoration pages) -->
    {% if page.url == '/janitorial/' or page.url == '/restoration/' %}
    <div class="floating-nav-info floating-nav-info--center desktop-only-info">
      <span class="floating-nav-address">41 Dussek St, Belleville, ON K8N 5R9</span>
      <span class="floating-nav-divider">•</span>
      <span class="floating-nav-phone-text">{{ site.phone }}</span>
      <span class="floating-nav-divider">•</span>
      <span class="floating-nav-email-text">mopsgroupofcompanies@gmail.com</span>
    </div>
    {% endif %}

    <!-- Right Controls: Contact Info & Hamburger Menu -->
    <div class="floating-nav-right">
      {% if page.url == '/janitorial/' %}
      <a href="#contact" class="floating-nav-cta floating-nav-cta--janitorial desktop-nav-btn">Contact</a>
      <a href="tel:6136144463" class="floating-nav-phone mobile-nav-btn">{{ site.phone }}</a>
      {% elif page.url == '/restoration/' %}
      <a href="#contact" class="floating-nav-cta floating-nav-cta--restoration desktop-nav-btn">Contact</a>
      <a href="tel:6136144463" class="floating-nav-phone mobile-nav-btn">{{ site.phone }}</a>
      {% else %}
      <div class="floating-nav-info">
        <span class="floating-nav-address">41 Dussek St, Belleville, ON K8N 5R9</span>
        <span class="floating-nav-divider">•</span>
        <span class="desktop-only-nav">
          <span class="floating-nav-phone-text">{{ site.phone }}</span>
          <span class="floating-nav-divider">•</span>
        </span>
        <span class="floating-nav-email-text desktop-only-email">mopsgroupofcompanies@gmail.com</span>
        <a href="tel:6136144463" class="floating-nav-mobile-phone mobile-only-phone">{{ site.phone }}</a>
      </div>
      {% endif %}
      <button class="floating-nav-hamburger" id="nav-hamburger" aria-label="Toggle navigation menu">
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </button>
    </div>

    <!-- Dropdown Menu with Separate Division Cards -->
    <div class="floating-dropdown{% if page.url == '/janitorial/' %} show-janitorial-only{% elif page.url == '/restoration/' %} show-restoration-only{% endif %}" id="nav-dropdown">
      <div class="floating-dropdown-grid">

        {% if page.url != '/restoration/' %}
        <!-- Janitorial Division Dropdown Card -->
        <div class="dropdown-division dropdown-division--janitorial">
          <ul class="dropdown-services">
            <li><a href="/janitorial/#hero">Home</a></li>
            <li><a href="/janitorial/#services">Services</a></li>
            <li><a href="/janitorial/#reviews">Reviews</a></li>
            <li><a href="/janitorial/#faq">Common Questions</a></li>
            <li><a href="/janitorial/#contact">Get in Touch</a></li>
          </ul>
          {% if page.url == '/janitorial/' %}
          <a href="/restoration/" class="dropdown-action dropdown-action--restoration">
            Switch to Restoration &rarr;
          </a>
          {% else %}
          <a href="/janitorial/" class="dropdown-action dropdown-action--janitorial">
            Janitorial Services
          </a>
          {% endif %}
        </div>
        {% endif %}

        {% if page.url != '/janitorial/' %}
        <!-- Restoration Division Dropdown Card -->
        <div class="dropdown-division dropdown-division--restoration">
          <ul class="dropdown-services">
            <li><a href="/restoration/#hero">Home</a></li>
            <li><a href="/restoration/#services">Services</a></li>
            <li><a href="/restoration/#process">Capabilities</a></li>
            <li><a href="/restoration/#trust">Certifications</a></li>
            <li><a href="/restoration/#rentals">Equipment Rentals</a></li>
            <li><a href="/restoration/#reviews">Reviews</a></li>
            <li><a href="/restoration/#faq">FAQ</a></li>
            <li><a href="/restoration/#contact">Contact Us</a></li>
          </ul>
          {% if page.url == '/restoration/' %}
          <a href="/janitorial/" class="dropdown-action dropdown-action--janitorial">
            Switch to Janitorial &rarr;
          </a>
          {% else %}
          <a href="/restoration/" class="dropdown-action dropdown-action--restoration">
            Restoration Services
          </a>
          {% endif %}
        </div>
        {% endif %}

      </div>
    </div>
  </div>
</header>

<script>
  (function () {
    // 1. Floating Dropdown Menu & Mobile Overlay Toggle
    const hamburger = document.getElementById('nav-hamburger');
    const dropdown = document.getElementById('nav-dropdown');
    const overlay = document.getElementById('nav-overlay');

    const toggleMenu = (openState) => {
      const isOpen = openState !== undefined ? openState : !dropdown.classList.contains('open');
      if (hamburger) hamburger.classList.toggle('active', isOpen);
      if (dropdown) dropdown.classList.toggle('open', isOpen);
      if (overlay) overlay.classList.toggle('open', isOpen);
    };

    if (hamburger && dropdown) {
      hamburger.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleMenu();
      });

      if (overlay) {
        overlay.addEventListener('click', () => toggleMenu(false));
      }

      document.addEventListener('click', (e) => {
        if (!dropdown.contains(e.target) && !hamburger.contains(e.target)) {
          toggleMenu(false);
        }
      });

      // Close dropdown when selecting any option link inside dropdown
      dropdown.addEventListener('click', (e) => {
        const link = e.target.closest('a');
        if (link) {
          toggleMenu(false);
        }
      });
    }

    // 2. IntersectionObserver for Scroll Reveal animations (.reveal, .faq-accordion details)
    const revealCallback = (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    };

    const io = new IntersectionObserver(revealCallback, { threshold: 0.05 });

    // 3. IntersectionObserver for Stat Circles count-up numbers ([data-target])
    const countCallback = (entries, obs) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        const el = entry.target;
        const target = parseInt(el.dataset.target, 10);
        if (isNaN(target)) return;

        const suffix = el.dataset.suffix || '';
        const formatComma = el.dataset.format === 'comma';
        const dur = 1500;
        const start = performance.now();

        (function tick(now) {
          const p = Math.min((now - start) / dur, 1);
          const val = Math.floor(p * (2 - p) * target);
          el.textContent = (formatComma ? val.toLocaleString() : val) + suffix;
          if (p < 1) requestAnimationFrame(tick);
          else el.textContent = (formatComma ? target.toLocaleString() : target) + suffix;
        })(start);

        obs.unobserve(el);
      });
    };

    const countIO = new IntersectionObserver(countCallback, { threshold: 0.1 });

    const initObservers = () => {
      document.querySelectorAll('.reveal, .reveal-up, .reveal-left, .reveal-right, .faq-accordion details').forEach(el => {
        io.observe(el);
      });

      document.querySelectorAll('[data-target]').forEach(el => {
        countIO.observe(el);
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initObservers);
    } else {
      initObservers();
    }
  })();
</script>